[Unit]
Description=Runs and keeps alive the artisan schedule:run process for snipe-prod

[Service]
Restart=always
WorkingDirectory=/var/www/snipe
ExecStart=/usr/bin/php artisan schedule:work
StandardOutput=append:/var/www/snipe/storage/logs/schedule.log
StandardError=append:/var/www/snipe/storage/logs/schedule.log

[Install]
WantedBy=default.target
